<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="Reciper.Views.RecipeDetailPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Title="{Binding Item.Title}">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Modifica" Clicked="OnEditClicked" />
        <ToolbarItem Text="Elimina" Clicked="OnDeleteClicked" Priority="1" />
    </ContentPage.ToolbarItems>
    <ScrollView Padding="16">
        <VerticalStackLayout Spacing="8">
            <Label Text="{Binding Item.Title}" FontSize="24" FontAttributes="Bold" />
            <Label Text="Ingredienti" FontAttributes="Bold" />
            <Label Text="{Binding Item.Guide}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>