<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="Reciper.Views.RecipeDetailPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Title="{Binding Item.Title}">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Modifica" Clicked="OnEditClicked" />
        <ToolbarItem Text="Elimina" Clicked="OnDeleteClicked" Priority="1" />
    </ContentPage.ToolbarItems>
    <Image HeightRequest="240" Aspect="AspectFill">
        <Image.Clip>
            <RoundRectangleGeometry CornerRadius="12" Rect="0,0,9999,240"/>
        </Image.Clip>
        <Image.Source>
            <UriImageSource Uri="{Binding Item.ImagePath}"
                    CachingEnabled="True"
                    CacheValidity="1.00:00:00"/>
        </Image.Source>
    </Image>

    <ScrollView Padding="16">
        <VerticalStackLayout Spacing="8">
            <Label Text="{Binding Item.Title}" FontSize="24" FontAttributes="Bold" />
            <Label Text="Ingredienti" FontAttributes="Bold" />
            <Label Text="{Binding Item.Guide}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>