<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Reciper.Views.RecipesPage"
    x:Name="RootRecipesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Ricette">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Aggiungi" Clicked="OnAddClicked" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="12">
        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
        <SearchBar Grid.Row="1"
             Placeholder="Cerca titolo, ingredienti, tag"
             Text="{Binding Query}" />

        <CollectionView Grid.Row="2"
                ItemsSource="{Binding Tags}"
                ItemsLayout="HorizontalList"
                HeightRequest="44"
                SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="10,6"
             Margin="0,0,8,0"
             HasShadow="False"
             CornerRadius="12">
                        <Frame.Triggers>
                            <DataTrigger TargetType="Frame"
                       Binding="{Binding IsSelected}"
                       Value="True">
                                <Setter Property="BackgroundColor" Value="#333"/>
                            </DataTrigger>
                            <DataTrigger TargetType="Frame"
                       Binding="{Binding IsSelected}"
                       Value="False">
                                <Setter Property="BackgroundColor" Value="#EEE"/>
                            </DataTrigger>
                        </Frame.Triggers>

                        <Label Text="{Binding Name}">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label"
                         Binding="{Binding IsSelected}"
                         Value="True">
                                    <Setter Property="TextColor" Value="White"/>
                                    <Setter Property="FontAttributes" Value="Bold"/>
                                </DataTrigger>
                                <DataTrigger TargetType="Label"
                         Binding="{Binding IsSelected}"
                         Value="False">
                                    <Setter Property="TextColor" Value="#222"/>
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>

                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer
              Command="{Binding BindingContext.ToggleTagCommand, Source={x:Reference Name=RootRecipesPage}}"
              CommandParameter="{Binding Name}" />
                        </Frame.GestureRecognizers>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <RefreshView Grid.Row="3"
               IsRefreshing="{Binding IsRefreshing}"
               Command="{Binding RefreshAsyncCommand}">
            <CollectionView ItemsSource="{Binding Items}" SelectionMode="Single" SelectionChanged="OnSelectionChanged">
                <CollectionView.EmptyView>
                    <Label Text="Nessuna ricetta" HorizontalOptions="Center" VerticalOptions="Center" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="8" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                            <Image Grid.RowSpan="2" WidthRequest="56" HeightRequest="56" Aspect="AspectFill">
                                <Image.Clip>
                                    <RoundRectangleGeometry CornerRadius="8" Rect="0,0,56,56"/>
                                </Image.Clip>
                                <Image.Source>
                                    <UriImageSource Uri="{Binding ImagePath}" CachingEnabled="True" CacheValidity="1.00:00:00"/>
                                </Image.Source>
                            </Image>

                            <Label Grid.Column="1" Text="{Binding Title}" FontAttributes="Bold" FontSize="16"/>
                            <Label Grid.Column="1" Grid.Row="1" Text="{Binding Tags[0]}" FontSize="12" TextColor="#666"/>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
